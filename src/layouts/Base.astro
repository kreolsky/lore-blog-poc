---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="alternate" type="application/rss+xml" title="Lore Blog PoC" href="/rss.xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="site-title" href="/">Lore Blog PoC</a>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
